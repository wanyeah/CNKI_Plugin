# ===== 服务监听（本地回环，别改成 0.0.0.0，Cookie 不暴露） =====
HOST=127.0.0.1
PORT=8765

# ===== 浏览器人工验证 =====
# 等待用户手动完成滑块的最长秒数
VERIFY_TIMEOUT_SECONDS=300
# Playwright 有头 Chromium（人工过滑块需要看见窗口）
HEADLESS=false

# ===== 检索限速（每次真实知网请求后的固定等待，秒） =====
REQUEST_DELAY_MIN=1.0
REQUEST_DELAY_MAX=2.0
# 单次请求失败重试次数
MAX_RETRIES=3

# ===== 缓存 =====
CACHE_TTL_SECONDS=3600
CACHE_DB_PATH=storage/cache.sqlite3
# 浏览器 storage_state 保存路径（含登录态，切勿外传）
STORAGE_STATE_PATH=storage/cnki_state.json

# ===== PDF 下载（服务端真实下载到 downloads/） =====
# 临时论文库（本次会话检索到的论文，start/stop 时清空）
PAPERS_DB_PATH=storage/papers.json
# 详情页请求间隔：每次之间随机等 2~4 秒，降低风控风险
PDF_DELAY_MIN=2.0
PDF_DELAY_MAX=4.0
# /download 批量一次最多几个 ID（真实下载，重操作）
PDF_SAVE_BATCH_MAX=3
# 下载文件保存目录（默认项目根目录 downloads/）
# DOWNLOAD_DIR=D:/path/to/downloads
# 下载浏览器是否无头：false=有头（便于人工登录兜底），true=静默
PDF_SAVE_HEADLESS=false
# 等待单次下载的超时秒数
PDF_SAVE_TIMEOUT_SECONDS=120

# ===== 说明 =====
# Cookie / 登录态不需要手填：第一次触发验证时会自动弹出浏览器，
# 你手动登录 + 过滑块后，服务把 storage_state 存到上面的路径，后续请求复用。
