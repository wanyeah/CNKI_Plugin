{
  "openapi": "3.1.0",
  "info": {
    "title": "知网论文检索 API",
    "description": "供 Agent 查询真实存在的知网论文，杜绝幻觉引用。\n\n核心特性：分页查询（page / page_size）、多关键词批量、来源可溯源（每条带 source_url）、遇到滑块自动弹出浏览器由人工完成。\n\n响应中的 query.total / has_more 可帮助 Agent 判断是否需要继续翻页。\n\nPDF 下载：/search 结果里的 paper_id 存入临时库。GET /download?paper_id=xxx 让服务端用浏览器复用登录态真实下载，返回本地文件路径（含 sha256，批量上限 3）。临时库在 start/stop 时清空。注意知网 2026 年下载走订单接口，必须用浏览器会话完成，不提供可直接 GET 的下载链接。",
    "version": "1.0.0"
  },
  "paths": {
    "/search": {
      "get": {
        "summary": "按关键词检索论文（分页）",
        "operationId": "search_search_get",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "检索词，如：中药",
              "title": "Keyword"
            },
            "description": "检索词，如：中药"
          },
          {
            "name": "field",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "检索字段码，可选：SU,TKA,KY,TI,FT,AU,FI,RP,AF,FU,AB,CO,RF,CLC,LY,DOI",
              "default": "SU",
              "title": "Field"
            },
            "description": "检索字段码，可选：SU,TKA,KY,TI,FT,AU,FI,RP,AF,FU,AB,CO,RF,CLC,LY,DOI"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "排序：relevance,time,cited,download,overall",
              "default": "relevance",
              "title": "Sort"
            },
            "description": "排序：relevance,time,cited,download,overall"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "第几页，从 1 开始",
              "default": 1,
              "title": "Page"
            },
            "description": "第几页，从 1 开始"
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 20,
              "minimum": 1,
              "description": "每页条数，1~20,默认10",
              "default": 10,
              "title": "Page Size"
            },
            "description": "每页条数，1~20,默认10"
          },
          {
            "name": "expert",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "是否把 keyword 当作知网专业检索表达式",
              "default": false,
              "title": "Expert"
            },
            "description": "是否把 keyword 当作知网专业检索表达式"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/batch": {
      "get": {
        "summary": "批量检索（多关键词，串行执行）",
        "operationId": "batch_batch_get",
        "parameters": [
          {
            "name": "keywords",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "多个检索词，如 ?keywords=中药&keywords=针灸",
              "title": "Keywords"
            },
            "description": "多个检索词，如 ?keywords=中药&keywords=针灸"
          },
          {
            "name": "field",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "检索字段码",
              "default": "SU",
              "title": "Field"
            },
            "description": "检索字段码"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "排序",
              "default": "relevance",
              "title": "Sort"
            },
            "description": "排序"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "第几页",
              "default": 1,
              "title": "Page"
            },
            "description": "第几页"
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 20,
              "minimum": 1,
              "description": "每页条数",
              "default": 10,
              "title": "Page Size"
            },
            "description": "每页条数"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/download": {
      "get": {
        "summary": "按论文 ID 下载 PDF（服务端真实下载到本地，上限 3 篇）",
        "description": "服务端用浏览器复用登录态真实点击下载，返回本地文件路径。\n\n- 成功时 `file` 字段为 SavedFile：path/filename/size_bytes/sha256/is_pdf。\n- 同步等待，一次最多 3 篇；逐条返回状态，一个失败不影响其他。\n\n注意：知网 2026 年下载走 bar.cnki.net 订单接口，没有可直接 GET 的 PDF 链接，\n因此本接口不返回下载网址，只负责把真实文件下载到 downloads/。",
        "operationId": "download_download_get",
        "parameters": [
          {
            "name": "paper_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "论文 ID（/search 返回的 paper_id），可重复传多个，最多 3 个",
              "title": "Paper Id"
            },
            "description": "论文 ID（/search 返回的 paper_id），可重复传多个，最多 3 个"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PdfLinkResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/papers/clear": {
      "post": {
        "summary": "清空临时论文库",
        "operationId": "clear_papers_papers_clear_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "健康检查",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/session/refresh": {
      "post": {
        "summary": "手动刷新登录态（弹出浏览器）",
        "description": "弹浏览器让用户登录知网 / 过滑块，保存会话。",
        "operationId": "refresh_session_session_refresh_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionRefreshResponse"
                }
              }
            }
          }
        }
      }
    },
    "/session/reset": {
      "post": {
        "summary": "清除登录态（下次检索重新验证）",
        "operationId": "reset_session_session_reset_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/fields": {
      "get": {
        "summary": "列出可用检索字段与排序码",
        "operationId": "fields_fields_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BatchKeywordResult": {
        "properties": {
          "keyword": {
            "type": "string",
            "title": "Keyword"
          },
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "response": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SearchResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "keyword",
          "success"
        ],
        "title": "BatchKeywordResult"
      },
      "BatchResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "default": true
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/BatchKeywordResult"
            },
            "type": "array",
            "title": "Results"
          },
          "notice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notice"
          }
        },
        "type": "object",
        "required": [
          "results"
        ],
        "title": "BatchResponse"
      },
      "ErrorResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "default": false
          },
          "error": {
            "type": "string",
            "title": "Error"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hint",
            "description": "给 Agent 或用户的处理建议"
          }
        },
        "type": "object",
        "required": [
          "error",
          "code"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "has_session": {
            "type": "boolean",
            "title": "Has Session",
            "description": "是否已有保存的登录态文件"
          },
          "cache_size": {
            "type": "integer",
            "title": "Cache Size",
            "description": "缓存条目数"
          },
          "paper_count": {
            "type": "integer",
            "title": "Paper Count",
            "description": "临时论文库中保存的论文数",
            "default": 0
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "1.0.0"
          }
        },
        "type": "object",
        "required": [
          "status",
          "has_session",
          "cache_size"
        ],
        "title": "HealthResponse"
      },
      "Paper": {
        "properties": {
          "n": {
            "type": "integer",
            "title": "N",
            "description": "在本页返回中的序号，从 1 开始"
          },
          "paper_id": {
            "type": "string",
            "title": "Paper Id",
            "description": "稳定 ID，供 /download 按 ID 取 PDF 直链",
            "default": ""
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "篇名",
            "default": ""
          },
          "authors": {
            "type": "string",
            "title": "Authors",
            "description": "作者，分号分隔",
            "default": ""
          },
          "journal": {
            "type": "string",
            "title": "Journal",
            "description": "来源期刊 / 学位论文单位",
            "default": ""
          },
          "date": {
            "type": "string",
            "title": "Date",
            "description": "发表日期 / 年份",
            "default": ""
          },
          "cited": {
            "type": "string",
            "title": "Cited",
            "description": "被引次数（知网原始文本）",
            "default": ""
          },
          "downloads": {
            "type": "string",
            "title": "Downloads",
            "description": "下载次数（知网原始文本）",
            "default": ""
          },
          "db": {
            "type": "string",
            "title": "Db",
            "description": "数据库来源",
            "default": ""
          },
          "doi": {
            "type": "string",
            "title": "Doi",
            "description": "DOI（列表页通常没有，留空）",
            "default": ""
          },
          "abstract": {
            "type": "string",
            "title": "Abstract",
            "description": "摘要（列表页通常没有，留空）",
            "default": ""
          },
          "keywords": {
            "type": "string",
            "title": "Keywords",
            "description": "关键词（列表页通常没有，留空）",
            "default": ""
          },
          "source_url": {
            "type": "string",
            "title": "Source Url",
            "description": "知网详情页链接，可溯源核对",
            "default": ""
          },
          "export_id": {
            "type": "string",
            "title": "Export Id",
            "description": "知网引用导出 ID，供后续扩展",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "n"
        ],
        "title": "Paper",
        "description": "一条文献题录。"
      },
      "PdfLinkItem": {
        "properties": {
          "paper_id": {
            "type": "string",
            "title": "Paper Id"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "论文标题（便于 Agent 核对，不信任时看 source_url）",
            "default": ""
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "结果状态，见类文档"
          },
          "can_download": {
            "type": "boolean",
            "title": "Can Download",
            "description": "是否已成功下载（等同 status==saved）",
            "default": false
          },
          "session_ready": {
            "type": "boolean",
            "title": "Session Ready",
            "description": "当前是否已有可用登录态",
            "default": false
          },
          "how_to": {
            "type": "string",
            "title": "How To",
            "description": "给调用方的下一步操作建议",
            "default": ""
          },
          "source_url": {
            "type": "string",
            "title": "Source Url",
            "description": "知网详情页，供溯源核对",
            "default": ""
          },
          "file": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SavedFile"
              },
              {
                "type": "null"
              }
            ],
            "description": "下载成功时的本地文件信息"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error",
            "description": "失败原因，status 为失败态时有值"
          },
          "fetched_at": {
            "type": "string",
            "title": "Fetched At",
            "description": "下载完成时间 ISO8601",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "paper_id",
          "status"
        ],
        "title": "PdfLinkItem",
        "description": "单篇论文的下载结果。批量 /download 时逐条返回，一个失败不影响其他。\n\n本接口只用浏览器真实下载到本地，不返回任何可直接 GET 的下载链接\n（知网 2026 年改走订单接口，链接点击会报「来源应用不正确(01)」）。\n\nstatus 取值：\n- saved       文件已落盘，读 file 字段\n- no_pdf      该类无 PDF（如报纸仅 CAJ）或详情页无下载按钮\n- need_login  下载平台（nxgp）未授权，需先 POST /session/refresh\n- not_found   ID 不在临时库\n- error       其他失败"
      },
      "PdfLinkResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "是否全部成功；有一条失败即为 false，但结果仍逐条返回"
          },
          "requested": {
            "type": "integer",
            "title": "Requested",
            "description": "请求的 ID 数量（去重截断后）"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/PdfLinkItem"
            },
            "type": "array",
            "title": "Results"
          },
          "notice": {
            "type": "string",
            "title": "Notice",
            "default": "仅返回你已获授权访问的文献；请遵守知网服务条款与个人学术研究用途。"
          }
        },
        "type": "object",
        "required": [
          "success",
          "requested",
          "results"
        ],
        "title": "PdfLinkResponse",
        "description": "GET /download 的响应。"
      },
      "QueryMeta": {
        "properties": {
          "keyword": {
            "type": "string",
            "title": "Keyword"
          },
          "field": {
            "type": "string",
            "title": "Field",
            "description": "检索字段码，如 SU"
          },
          "field_label": {
            "type": "string",
            "title": "Field Label",
            "description": "检索字段中文名，如 主题"
          },
          "sort": {
            "type": "string",
            "title": "Sort"
          },
          "page": {
            "type": "integer",
            "title": "Page",
            "description": "本次返回的是第几页（用户视角，从 1 开始）"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size",
            "description": "本页每页条数（用户视角）"
          },
          "total": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total",
            "description": "知网返回命中总数，解析失败为 null"
          },
          "total_pages": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Pages",
            "description": "按 page_size 估算的总页数"
          },
          "returned": {
            "type": "integer",
            "title": "Returned",
            "description": "本页实际返回条数"
          },
          "has_more": {
            "type": "boolean",
            "title": "Has More",
            "description": "是否可能还有下一页"
          },
          "fetched_at": {
            "type": "string",
            "title": "Fetched At",
            "description": "数据抓取时间 ISO8601"
          },
          "from_cache": {
            "type": "boolean",
            "title": "From Cache",
            "description": "是否来自缓存",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "keyword",
          "field",
          "field_label",
          "sort",
          "page",
          "page_size",
          "returned",
          "has_more",
          "fetched_at"
        ],
        "title": "QueryMeta",
        "description": "检索元信息，帮助 Agent 判断数据边界，避免把第一页当全部。"
      },
      "SavedFile": {
        "properties": {
          "path": {
            "type": "string",
            "title": "Path",
            "description": "本机绝对路径，用户 / Agent 可直接读取"
          },
          "filename": {
            "type": "string",
            "title": "Filename",
            "description": "清洗后的建议文件名"
          },
          "size_bytes": {
            "type": "integer",
            "title": "Size Bytes",
            "description": "文件字节数"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256",
            "description": "文件 SHA-256，供校验与去重"
          },
          "is_pdf": {
            "type": "boolean",
            "title": "Is Pdf",
            "description": "文件头是否为 %PDF"
          }
        },
        "type": "object",
        "required": [
